# Template for .env. `python setup.py` copies it to .env on a fresh clone.
# Every setting is read in config/config.py and nowhere else. A line left commented keeps the default.

# Application
APP_ENV=development
LOG_LEVEL=INFO
# LOG_FILE=logs/grant-intelligence.log

# Data folders (defaults: the synthetic corpus and data/processed inside the repository)
# RAW_DATA_DIR=data/synthetic/raw
# PSEUDONYMISED_DIR=data/processed/pseudonymised
# PROCESSED_DIR=data/processed

# Privacy (docs/data-handling.md)
# Must point outside the repository. Required when APP_ENV=production.
# Default in development: <home>/grant-intelligence-private/pseudonym_map.csv
# PSEUDONYM_MAP_PATH=/absolute/path/outside/the/repository/pseudonym_map.csv

# Publication linkage (docs/linkage-methodology.md)
# Optional contact address for the OpenAlex polite pool. Leave empty to send none.
OPENALEX_EMAIL=
OPENALEX_TIMEOUT=10
OPENALEX_RETRIES=4

# Statistics (docs/statistics-methodology.md). Do not change once results are reported.
SEED=42
ALPHA=0.05
CONFIDENCE_LEVEL=0.95
BOOTSTRAP_RESAMPLES=10000
PERMUTATIONS=10000

# Generation (rule 1.2). Zero temperature: translations are deterministic.
TEMPERATURE=0
