# Keep the image small and keep local state and settings out of it.

# Version control and tooling
.git
.gitignore
.pytest_cache
**/__pycache__
*.py[cod]
venv
.venv

# Local settings: passed in at run time by docker-compose (env_file), never baked into the image
.env

# Data: the image carries only what the dashboard reads (data/processed, about 90 MB, and results/),
# so it is populated even without the bind mounts of docker-compose.yml. The raw corpus, the
# generator's answer key, quarantined files and rows saved by the capture forms stay out.
data/*
!data/processed

# Logs and the cache of external lookups
logs
*.log
cache/openalex

# Outputs written to the repository root by the pipeline
criteria_validity_results.csv
supplementary_analyses_results.png

# Not needed to run
Dockerfile
docker-compose.yml
.dockerignore
