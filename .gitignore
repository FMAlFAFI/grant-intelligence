# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Environment (the template .env.example is committed, the real file is not)
.env

# Data and logs (rule 1.9)
*.csv
*.log
logs/
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Run outputs: produced by the pipeline, never committed
/results/
/supplementary_analyses_results.png

# Labelled evaluation sets and the results computed from them are evidence, so they are committed
!evaluation/**/*.csv

# Caches (rule 1.9), except the evaluation cache of model calls, which rule 1.5 says to commit
cache/*
!cache/.gitkeep
!cache/embeddings/
!cache/translations/
